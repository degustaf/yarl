module PFs

const fountain_color : Colors.fountain
const light_color : Colors.light

prefab fountain {
  Renderable: {
    ch: '&'
    fg: fountain_color
    layer: Actor
  }
  Named: {
    name: "fountain"
  }
  BlocksMovement
  Fountain
}

prefab light {
  Renderable: {
    ch: '*'
    fg: light_color
    layer: Corpse
  }
  Named: {
    name: "light"
  }
  Light : {
    innerRadius: 3
    outerRadius: 6
    decayFactor: 0.8
  }
}
